# Environment for the Jukebox release (loaded by jukebox.service).
# Copy to /etc/jukebox/jukebox.env and keep it readable by the jukebox user only.

# Required. Generate with: mix phx.gen.secret
SECRET_KEY_BASE=replace-me-with-the-output-of-mix-phx-gen-secret

# Start the HTTP server inside the release.
PHX_SERVER=true

# Bind to loopback only (Chromium runs on the same Pi). Use 0.0.0.0 to allow
# LAN access for diagnostics.
JUKEBOX_BIND=127.0.0.1
PORT=4000
PHX_HOST=localhost

# Metadata adapter: "mqtt" (Shairport Sync over the local broker) or "demo".
JUKEBOX_METADATA_ADAPTER=mqtt
JUKEBOX_MQTT_HOST=127.0.0.1
JUKEBOX_MQTT_PORT=1883
JUKEBOX_MQTT_TOPIC=jukebox/shairport
JUKEBOX_MQTT_CLIENT_ID=jukebox-display
# Optional broker credentials (leave unset for an anonymous local broker).
# JUKEBOX_MQTT_USERNAME=
# JUKEBOX_MQTT_PASSWORD=

# Relay Previous / Play-Pause / Next to the sender through Shairport Sync.
JUKEBOX_REMOTE_CONTROL_ENABLED=true

# Grace period (ms) between the end of an AirPlay session and the idle screen.
JUKEBOX_IDLE_TIMEOUT_MS=5000

# How long (ms) a burst of metadata messages is buffered before the screen
# updates once. A track change arrives as many small MQTT messages.
JUKEBOX_COALESCE_MS=150

# Animation style used until the animation button has chosen another: "calm"
# (no waves), "waves", "chase" (lights pass their colours along on the beat)
# or "party" (random colours). The button cycles through them and the last
# choice is saved, so this value only matters on the first boot.
JUKEBOX_ANIMATION_STYLE=chase

# Directory where the last chosen animation style is saved. The systemd unit
# creates /var/lib/jukebox (StateDirectory=jukebox); change this only if the
# release runs some other way.
# JUKEBOX_STATE_DIR=/var/lib/jukebox

# Tempo (beats per minute) of the "chase" and "party" lights when the audio is
# not analysed, or when the analyser is not sure of the beat.
JUKEBOX_ANIMATION_BPM=120

# --- Audio-reactive animation (docs/audio-reactive-setup.md) ----------------
# Off by default. Turn it on only after the ALSA tap and the native analyser
# are installed; until then, and whenever the analyser is not running, the
# display simply keeps its fixed-tempo animation.
AUDIO_REACTIVE_ENABLED=false

# Where the analysis comes from: "native" (the analyser fed by the ALSA tap),
# "simulated" (made-up music, for a demonstration) or "disabled".
AUDIO_REACTIVE_SOURCE=native

# Unix datagram socket the analyser sends to. Must be the --socket of the
# ALSA device (ops/audio/jukebox-tap.conf.example).
AUDIO_ANALYSIS_SOCKET=/run/jukebox/audio-analysis.sock

# Most analysis frames per second passed on to the browser (1 to 20). Keep it
# equal to --publish-rate in the ALSA device.
AUDIO_ANALYSIS_PUBLISH_RATE=20

# How long (ms, 0 to 1000) the browser holds each frame before showing it.
# The application's own default is 120, but start at 0 on the Pi: the ALSA
# tap hands samples to the analyser after they were queued for the DAC, not
# before, so a delay can only make the lights later. Raise it only if the
# lights turn out to be ahead of the sound (see "Calibrating" in the guide).
AUDIO_VISUAL_DELAY_MS=0

# Confidence (0 to 1) the beat tracker must report before its beats drive the
# lights. Below it the fixed tempo above is used; loudness, bass and attacks
# are followed either way.
AUDIO_BEAT_CONFIDENCE_THRESHOLD=0.45

# --- Physical controls (docs/physical-controls.md) ---------------------------
# Eight buttons on a USB encoder, software dimming of the screen, and the
# lights behind the power controller. The buttons are OFF until they have been
# commissioned on this very machine: no button code or input device is ever
# assumed. A wrong value here never stops the display or the music; it
# switches off the part it belongs to and says why in the journal
# (journalctl -u jukebox | grep hardware). Restart jukebox.service to apply a
# change; nothing has to be rebuilt.

# Master switch of the buttons.
JUKEBOX_BUTTONS_ENABLED=false

# Where key events come from: "evdev" (a Linux input device). "simulated"
# exists for development only and is refused here.
JUKEBOX_BUTTONS_SOURCE=evdev

# The encoder's event device, by its STABLE link, for example
# /dev/input/by-id/usb-<name of the encoder>-event-joystick (list them with
# ls -l /dev/input/by-id/). Never /dev/input/eventN: that number changes.
JUKEBOX_BUTTONS_DEVICE=

# A press closer than this (ms) to the previous press or release of the same
# button is contact bounce and is ignored.
JUKEBOX_BUTTONS_DEBOUNCE_MS=80

# true: log every key event and what was decided, for commissioning.
JUKEBOX_BUTTONS_DEBUG=false

# One decimal Linux EV_KEY code per action, as printed by
#   /usr/bin/python3 /opt/jukebox/lib/jukebox-*/priv/hardware/xinmo_evdev.py \
#       --device <the link above> --diagnose
# These are NOT joystick button indices, GPIO numbers or the numbers printed
# on the encoder's terminals. Empty: the action has no button. The same code
# twice is an error.
JUKEBOX_BUTTON_PREVIOUS=
JUKEBOX_BUTTON_PLAY_PAUSE=
JUKEBOX_BUTTON_NEXT=
JUKEBOX_BUTTON_DISCO_TOGGLE=
JUKEBOX_BUTTON_STRIP_TOGGLE=
JUKEBOX_BUTTON_ANIMATION_NEXT=
JUKEBOX_BUTTON_BRIGHTNESS_DOWN=
JUKEBOX_BUTTON_BRIGHTNESS_UP=

# Screen brightness: X11 software dimming of the kiosk's output, with xrandr.
# It scales the picture's gamma ramp. It does NOT change the monitor's
# backlight or the value in its own menu (the HDMI-to-VGA adapter carries no
# DDC). Backends: "xrandr" or "disabled". The values below are the ones
# measured on this jukebox; if X11 is not running yet the jukebox starts
# anyway and applies the brightness when the display answers.
JUKEBOX_BRIGHTNESS_BACKEND=xrandr

# The output to dim, exactly as `xrandr --query` names the connected one (not
# the DRM connector name card0-HDMI-A-1). Never guessed, never "the first".
JUKEBOX_XRANDR_OUTPUT=HDMI-1

# The kiosk's X display and its authority file. The service does not inherit
# them from the graphical session.
JUKEBOX_X11_DISPLAY=:0
JUKEBOX_X11_XAUTHORITY=/home/jukebox/.Xauthority

# Coefficients, not percentages: 1.0 is the picture as it is (no dimming),
# 0.3 a very dark one. 0 < MIN < MAX <= 1.0, MIN <= DEFAULT <= MAX and
# 0 < STEP <= MAX - MIN. Each press moves the brightness by STEP.
JUKEBOX_BRIGHTNESS_MIN=0.3
JUKEBOX_BRIGHTNESS_MAX=1.0
JUKEBOX_BRIGHTNESS_STEP=0.1

# Brightness applied when the jukebox service starts. What the buttons set
# afterwards is kept in memory only: it survives standby, a browser or X
# restart, not a restart of the service or of the Pi. Set for example 0.7 to
# always start darker.
JUKEBOX_BRIGHTNESS_DEFAULT=1.0

# Longest a single xrandr call may take (ms) before it is killed.
JUKEBOX_BRIGHTNESS_TIMEOUT_MS=3000

# The power controller (ops/hardware/): its client, used for the lights, and
# the state it publishes. While that state is missing or more than 3 s old
# the buttons do nothing.
JUKEBOX_POWER_CLIENT=/usr/local/sbin/jukebox-power-controller.py
JUKEBOX_POWER_STATE_FILE=/run/jukebox-power/state.json

# LED strip button: "power" switches the strip's supply through the power
# controller; "wled" keeps the supply on while awake and switches the strip
# through the WLED controller at JUKEBOX_WLED_URL (for example
# http://192.168.1.50). If WLED does not answer the press has no effect; it is
# never turned into a power toggle.
JUKEBOX_STRIP_CONTROL=power
JUKEBOX_WLED_URL=
