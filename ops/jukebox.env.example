# Environment for the Jukebox release (loaded by jukebox.service).
# Copy to /etc/jukebox/jukebox.env and keep it readable by the jukebox user only.

# Required. Generate with: mix phx.gen.secret
SECRET_KEY_BASE=replace-me-with-the-output-of-mix-phx-gen-secret

# Start the HTTP server inside the release.
PHX_SERVER=true

# Bind to loopback only (Chromium runs on the same Pi). Use 0.0.0.0 to allow
# LAN access for diagnostics.
JUKEBOX_BIND=127.0.0.1
PORT=4000
PHX_HOST=localhost

# Metadata adapter: "mqtt" (Shairport Sync over the local broker) or "demo".
JUKEBOX_METADATA_ADAPTER=mqtt
JUKEBOX_MQTT_HOST=127.0.0.1
JUKEBOX_MQTT_PORT=1883
JUKEBOX_MQTT_TOPIC=jukebox/shairport
JUKEBOX_MQTT_CLIENT_ID=jukebox-display
# Optional broker credentials (leave unset for an anonymous local broker).
# JUKEBOX_MQTT_USERNAME=
# JUKEBOX_MQTT_PASSWORD=

# Relay Previous / Play-Pause / Next to the sender through Shairport Sync.
JUKEBOX_REMOTE_CONTROL_ENABLED=true

# Grace period (ms) between the end of an AirPlay session and the idle screen.
JUKEBOX_IDLE_TIMEOUT_MS=5000
